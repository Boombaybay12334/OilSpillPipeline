# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to git or share it in chat/screenshots.

# Your CDSE login email (dataspace.copernicus.eu)
CDSE_USERNAME=your-email@example.com

# Your CDSE password
CDSE_PASSWORD=your-password-here

# Only needed if you have 2FA enabled on your CDSE account. Leave blank otherwise.
CDSE_TOTP=

# Optional: only needed if `gpt` isn't on your PATH.
# Windows example: C:\Program Files\esa-snap\bin\gpt.exe
# Mac example:     /Applications/esa-snap/bin/gpt
# Linux example:   /opt/esa-snap/bin/gpt
GPT_EXECUTABLE=
