# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to git or share it in chat/screenshots.

# Your CDSE login email (dataspace.copernicus.eu)
CDSE_USERNAME=your-email@example.com

# Your CDSE password
CDSE_PASSWORD=your-password-here

# Only needed if you have 2FA enabled on your CDSE account. Leave blank otherwise.
CDSE_TOTP=

# Optional: only needed if `gpt` isn't on your PATH.
# Windows example: C:\Program Files\esa-snap\bin\gpt.exe
# Mac example:     /Applications/esa-snap/bin/gpt
# Linux example:   /opt/esa-snap/bin/gpt
GPT_EXECUTABLE=

# Optional: base directory runs/<run_id>/ is organized under when a
# /detect request (or DetectionRequest) doesn't specify its own
# output_dir. Defaults to a `data/` folder next to config.py.
# Point this at a mounted volume when running in a container.
OILSPILL_DATA_DIR=

# Optional: path to events_registry.json. Defaults to the copy shipped
# next to fetch_s1.py. Point this somewhere persistent (e.g. a mounted
# volume) if running in a container, so events registered via POST
# /events survive a container restart.
EVENTS_REGISTRY_PATH=

# Optional: path to the SNAP gpt graph XML. Defaults to
# s1_preprocess_graph.xml next to preprocess_and_infer.py.
GRAPH_XML_PATH=
